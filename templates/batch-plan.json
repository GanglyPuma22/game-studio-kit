{
  "schema_version": 1,
  "kind": "launch-batch-plan",
  "invariants": [
    {
      "field": "/summary/scene",
      "equals": "res://scenes/game_entry.tscn"
    },
    {
      "field": "/summary/renderer",
      "equals": "forward_plus"
    }
  ],
  "must_vary": [
    "/summary/population"
  ],
  "runs": [
    {
      "label": "run-id-stage-1",
      "scope": "macro-terrain",
      "mode": "native",
      "script": "res://tests/route.gd",
      "timeout": 600,
      "results": [
        "artifacts/route-summary.json"
      ]
    },
    {
      "label": "run-id-stage-2",
      "scope": "three-sites",
      "mode": "check",
      "script": "res://tests/compile_check.gd",
      "timeout": 120,
      "results": [
        "artifacts/compile-check.json"
      ],
      "scrub_env": [],
      "passthrough": []
    }
  ]
}
